# Copy to .env and export, or set in your host's config. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
# Required when running more than one server process (WebSocket messages are shared via Redis).
# REDIS_URL=redis://localhost:6379
